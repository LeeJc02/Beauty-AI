# 本地开发：接口全部由 src/mock 拦截，不发真实请求
NODE_ENV=development

# 请求路径（留空表示同源 /admin-api，交由本地 mock 适配器处理）
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传
VITE_UPLOAD_TYPE=client

# 接口地址
VITE_API_URL=/admin-api

# 是否删除 debugger
VITE_DROP_DEBUGGER=false

# 是否删除 console.log
VITE_DROP_CONSOLE=false

# 是否 sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist

# 构建时排除未启用的业务模块，多个模块用逗号分隔
VITE_DISABLED_VIEW_MODULES=
